<Window x:Class="GymWpfApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập - Gym Manager" Height="550" Width="500"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundColor}"
        ResizeMode="NoResize" AllowsTransparency="True" WindowStyle="None">

    <Border CornerRadius="16" Background="{StaticResource BackgroundColor}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Close Button -->
            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="40" Height="40" Margin="10" Background="Transparent"
                    BorderThickness="0" Foreground="{StaticResource TextSecondaryColor}"
                    FontSize="20" FontWeight="Bold" Cursor="Hand"
                    Click="BtnClose_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Login Form -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="40,10,40,40">
                <StackPanel VerticalAlignment="Center">
                    <!-- Logo Section -->
                    <Border Width="80" Height="80" CornerRadius="40"
                            Background="{StaticResource PrimaryColor}"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="🏋️" FontSize="45"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="GYM MANAGER" FontSize="32" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{StaticResource PrimaryColor}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Đăng nhập để tiếp tục" FontSize="14"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryColor}"
                               Margin="0,0,0,35"/>

                    <!-- Username Field -->
                    <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8"/>
                    <TextBox x:Name="txtUsername" Style="{StaticResource ModernUserTextBox}"
                             TabIndex="1"/>

                    <!-- Password Field -->
                    <TextBlock Text="Mật khẩu" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryColor}" Margin="0,20,0,8"/>
                    <PasswordBox x:Name="txtPassword" Style="{StaticResource ModernPasswordBox}"
                                 TabIndex="2"/>

                    <!-- Remember Me & Forgot Password -->
                    <Grid Margin="0,15,0,0">
                        <CheckBox Content="Ghi nhớ đăng nhập" Foreground="{StaticResource TextSecondaryColor}"
                                  VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Text="Quên mật khẩu?" HorizontalAlignment="Right"
                                   Foreground="{StaticResource PrimaryColor}" FontSize="13"
                                   Cursor="Hand" FontWeight="SemiBold"
                                   MouseLeftButtonDown="BtnForgotPassword_Click">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <!-- Login Button -->
                    <Button x:Name="btnLogin" Content="ĐĂNG NHẬP"
                            Style="{StaticResource ModernButton}"
                            Height="50" Margin="0,30,0,0" FontSize="16"
                            Click="BtnLogin_Click" TabIndex="3"/>

                    <!-- Default Credentials Info -->
                    <Border Background="#FFF9E6" CornerRadius="8" Padding="15" Margin="0,25,0,0"
                            BorderBrush="{StaticResource WarningColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🔑 Tài khoản mặc định" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentColor}" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryColor}">
                                <Run Text="Tên đăng nhập:" FontWeight="SemiBold"/>
                                <Run Text="admin"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryColor}">
                                <Run Text="Mật khẩu:" FontWeight="SemiBold"/>
                                <Run Text="123456"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
