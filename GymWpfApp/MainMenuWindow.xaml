<Window x:Class="GymWpfApp.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gym Manager System" Height="800" Width="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundColor}"
        ResizeMode="CanResize" MinHeight="700" MinWidth="1000">

    <Grid>
        <!-- Main Menu Page -->
        <Grid x:Name="MenuPage" Margin="40" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,40" Padding="30">
                <StackPanel>
                    <Border Width="90" Height="90" CornerRadius="45"
                            Background="{StaticResource PrimaryColor}"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="🏋️" FontSize="50"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="GYM MANAGER SYSTEM" FontSize="36" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{StaticResource PrimaryColor}"/>
                    <TextBlock Text="Hệ thống quản lý phòng tập thể hình" FontSize="15"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryColor}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Menu Cards Grid -->
            <UniformGrid Grid.Row="1" Columns="3" Rows="1" Margin="0,0,0,30" VerticalAlignment="Center">
                <!-- Members Card -->
                <Button x:Name="btnMembers" Click="BtnMembers_Click" Margin="15" Cursor="Hand"
                        Background="Transparent" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{StaticResource SurfaceColor}"
                                                CornerRadius="16" Padding="30,35">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Gray" BlurRadius="20" ShadowDepth="0" Opacity="0.12"/>
                                            </Border.Effect>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="100" Height="100" CornerRadius="50"
                                                        Background="#FFEBEE" Margin="0,0,0,25">
                                                    <TextBlock Text="👥" FontSize="55"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="QUẢN LÝ HỘI VIÊN" FontSize="18" FontWeight="Bold"
                                                           HorizontalAlignment="Center" Foreground="{StaticResource PrimaryColor}"
                                                           Margin="0,0,0,12"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFEBEE"/>
                                                <Setter TargetName="border" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="{Binding Color, Source={StaticResource PrimaryColor}}"
                                                                          BlurRadius="30" ShadowDepth="0" Opacity="0.4"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Staff Card -->
                <Button x:Name="btnStaff" Click="BtnStaff_Click" Margin="15" Cursor="Hand"
                        Background="Transparent" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{StaticResource SurfaceColor}"
                                                CornerRadius="16" Padding="30,35">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Gray" BlurRadius="20" ShadowDepth="0" Opacity="0.12"/>
                                            </Border.Effect>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="100" Height="100" CornerRadius="50"
                                                        Background="#E3F2FD" Margin="0,0,0,25">
                                                    <TextBlock Text="👔" FontSize="55"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="QUẢN LÝ NHÂN SỰ" FontSize="18" FontWeight="Bold"
                                                           HorizontalAlignment="Center" Foreground="{StaticResource SecondaryColor}"
                                                           Margin="0,0,0,12"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                                <Setter TargetName="border" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="{Binding Color, Source={StaticResource SecondaryColor}}"
                                                                          BlurRadius="30" ShadowDepth="0" Opacity="0.4"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Equipment Card -->
                <Button x:Name="btnEquipment" Click="BtnEquipment_Click" Margin="15" Cursor="Hand"
                        Background="Transparent" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{StaticResource SurfaceColor}"
                                                CornerRadius="16" Padding="30,35">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Gray" BlurRadius="20" ShadowDepth="0" Opacity="0.12"/>
                                            </Border.Effect>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="100" Height="100" CornerRadius="50"
                                                        Background="#FFF3E0" Margin="0,0,0,25">
                                                    <TextBlock Text="🏋️" FontSize="55"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="QUẢN LÝ THIẾT BỊ" FontSize="18" FontWeight="Bold"
                                                           HorizontalAlignment="Center" Foreground="{StaticResource AccentColor}"
                                                           Margin="0,0,0,12"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFF3E0"/>
                                                <Setter TargetName="border" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="{Binding Color, Source={StaticResource AccentColor}}"
                                                                          BlurRadius="30" ShadowDepth="0" Opacity="0.4"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>

            <!-- Footer with Logout -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryColor}" FontSize="13">
                        <Run Text="Phiên bản: 1.0.0"/>
                        <Run Text="•"/>
                        <Run Text="Hệ thống quản lý Gym"/>
                    </TextBlock>
                    <Button Content="THOÁT" Style="{StaticResource OutlineButton}"
                            Width="150" Height="45" HorizontalAlignment="Right"
                            Click="BtnLogout_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
