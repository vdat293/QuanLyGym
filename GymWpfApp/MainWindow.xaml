<Window x:Class="GymWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gym Manager WPF" Height="600" Width="900" WindowStartupLocation="CenterScreen" Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="White" Margin="0,0,0,0">
            <Border Background="Crimson" Padding="10">
                <TextBlock Text="THÊM THÀNH VIÊN" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Margin="15">
                <TextBlock Text="Họ Tên:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBox x:Name="txtName" Padding="5"/>

                <TextBlock Text="Số Điện Thoại:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBox x:Name="txtPhone" Padding="5"/>

                <TextBlock Text="Giới Tính:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <ComboBox x:Name="cbGender" Padding="5">
                    <ComboBoxItem Content="Nam"/>
                    <ComboBoxItem Content="Nữ"/>
                </ComboBox>

                <TextBlock Text="Tuổi:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBox x:Name="txtAge" Padding="5"/>

                <TextBlock Text="Phí Hàng Tháng:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBox x:Name="txtAmount" Padding="5"/>

                <TextBlock Text="Khung Giờ:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <ComboBox x:Name="cbTiming" Padding="5">
                    <ComboBoxItem Content="6AM - 8AM"/>
                    <ComboBoxItem Content="8AM - 10AM"/>
                    <ComboBoxItem Content="5PM - 7PM"/>
                    <ComboBoxItem Content="7PM - 9PM"/>
                </ComboBox>

                <Button x:Name="btnAdd" Content="THÊM MỚI" Background="Crimson" Foreground="White" 
                        Height="40" Margin="0,25,0,0" FontWeight="Bold" Click="BtnAdd_Click"/>

                <Button x:Name="btnClear" Content="Nhập Lại" Background="Gray" Foreground="White" 
                        Height="30" Margin="0,10,0,0" Click="BtnClear_Click"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                <TextBox x:Name="txtSearch" Width="300" Padding="5" ToolTip="Nhập tên để tìm..."/>
                <Button Content="TÌM KIẾM" Width="100" Margin="10,0,0,0" Background="DodgerBlue" Foreground="White" Click="BtnSearch_Click"/>
                <Button Content="LÀM MỚI" Width="100" Margin="10,0,0,0" Background="Orange" Foreground="White" Click="BtnRefresh_Click"/>
            </StackPanel>

            <DataGrid x:Name="gridMembers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                      CanUserAddRows="False" SelectionMode="Single" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Họ Tên" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="SĐT" Binding="{Binding Phone}" Width="100"/>
                    <DataGridTextColumn Header="Giới Tính" Binding="{Binding Gender}" Width="80"/>
                    <DataGridTextColumn Header="Tuổi" Binding="{Binding Age}" Width="50"/>
                    <DataGridTextColumn Header="Phí" Binding="{Binding Amount}" Width="80"/>
                    <DataGridTextColumn Header="Giờ Tập" Binding="{Binding Timing}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
                <TextBlock Text="Chọn một dòng để xóa" VerticalAlignment="Center" Margin="0,0,10,0" FontStyle="Italic" Foreground="Gray"/>
                <Button Content="XÓA THÀNH VIÊN" Background="Red" Foreground="White" Width="150" Height="35" Click="BtnDelete_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>