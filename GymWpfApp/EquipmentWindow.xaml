<Window x:Class="GymWpfApp.EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Cơ Sở Vật Chất - Gym Manager" Height="940" Width="1400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundColor}"
        ResizeMode="CanResize" MinHeight="700" MinWidth="1250">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,15" Margin="0,0,0,20">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="⬅ QUAY VỀ" Style="{StaticResource OutlineButton}"
                            Width="130" Height="40" Click="BtnBack_Click"/>
                    <Border Width="50" Height="50" CornerRadius="25"
                            Background="#FFF3E0" Margin="20,0,15,0">
                        <TextBlock Text="🏋️" FontSize="26"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUẢN LÝ CƠ SỞ VẬT CHẤT" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource AccentColor}"/>
                        <TextBlock Text="Thêm, sửa, xóa và quản lý thiết bị phòng tập"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryColor}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form Panel -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Border Background="{StaticResource AccentColor}" CornerRadius="8,8,0,0" Padding="15" Margin="-20,-20,-20,0">
                        <TextBlock Text="THÔNG TIN THIẾT BỊ" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" FontSize="15"/>
                    </Border>

                    <StackPanel Margin="0,20,0,0">
                        <TextBlock x:Name="lblFormTitle" Text="THÊM MỚI" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Mã Thiết Bị" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtCode" Style="{StaticResource ModernTextBox}"
                                 ToolTip="VD: TB001, MCB01"/>

                        <TextBlock Text="Tên Thiết Bị" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,15,0,8"/>
                        <TextBox x:Name="txtName" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Loại Thiết Bị" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,15,0,8"/>
                        <ComboBox x:Name="cbCategory" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Máy Chạy Bộ"/>
                            <ComboBoxItem Content="Tạ Đơn"/>
                            <ComboBoxItem Content="Ghế Tập"/>
                            <ComboBoxItem Content="Xe Đạp"/>
                            <ComboBoxItem Content="Máy Kéo Cao"/>
                            <ComboBoxItem Content="Dụng Cụ Yoga"/>
                            <ComboBoxItem Content="Khác"/>
                        </ComboBox>

                        <TextBlock Text="Cơ Sở" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,15,0,8"/>
                        <ComboBox x:Name="cbLocation" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Cơ Sở 1 - Quận 1"/>
                            <ComboBoxItem Content="Cơ Sở 2 - Quận 3"/>
                            <ComboBoxItem Content="Cơ Sở 3 - Quận 5"/>
                            <ComboBoxItem Content="Cơ Sở 4 - Quận 7"/>
                            <ComboBoxItem Content="Cơ Sở 5 - Quận 10"/>
                        </ComboBox>

                        <TextBlock Text="Trạng Thái" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,15,0,8"/>
                        <ComboBox x:Name="cbStatus" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Tốt" IsSelected="True"/>
                            <ComboBoxItem Content="Hư Hại"/>
                            <ComboBoxItem Content="Đang Bảo Dưỡng"/>
                            <ComboBoxItem Content="Ngừng Sử Dụng"/>
                        </ComboBox>

                        <TextBlock Text="Ghi Chú" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,15,0,8"/>
                        <TextBox x:Name="txtNotes" Style="{StaticResource ModernTextBox}"
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Button x:Name="btnSave" Content="THÊM MỚI" Style="{StaticResource AccentButton}"
                                Height="45" Margin="0,25,0,0" Click="BtnSave_Click"/>

                        <Button x:Name="btnClear" Content="Nhập Lại" Style="{StaticResource OutlineButton}"
                                Height="40" Margin="0,12,0,0" Click="BtnClear_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data Panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Danh Sách Thiết Bị" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSearch" Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                     ToolTip="Nhập tên hoặc mã để tìm kiếm..."/>
                            <Button Content="TÌM KIẾM" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Width="130" Margin="10,0,0,0" Click="BtnSearch_Click"/>
                            <Button Content="LÀM MỚI" Grid.Column="2" Style="{StaticResource AccentButton}"
                                    Width="130" Margin="10,0,0,0" Click="BtnRefresh_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Data Grid -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            CornerRadius="8" Background="{StaticResource SurfaceColor}">
                        <DataGrid x:Name="gridEquipment" Style="{StaticResource ModernDataGrid}"
                                  SelectionChanged="GridEquipment_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Mã TB" Binding="{Binding Code}" Width="90"/>
                                <DataGridTextColumn Header="Tên Thiết Bị" Binding="{Binding Name}" Width="*" MinWidth="130"/>
                                <DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="Cơ Sở" Binding="{Binding Location}" Width="140"/>
                                <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="120"/>
                                <DataGridTextColumn Header="Ghi Chú" Binding="{Binding Notes}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Action Bar -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Button Content="XÓA" HorizontalAlignment="Right"
                                Style="{StaticResource DangerButton}"
                                Width="100" Height="45" Click="BtnDelete_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
