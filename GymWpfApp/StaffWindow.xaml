<Window x:Class="GymWpfApp.StaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Nhân Sự - Gym Manager" Height="920" Width="1400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundColor}"
        ResizeMode="CanResize" MinHeight="700" MinWidth="1200">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,15" Margin="0,0,0,20">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="⬅ QUAY VỀ" Style="{StaticResource OutlineButton}"
                            Width="130" Height="40" Click="BtnBack_Click"/>
                    <Border Width="50" Height="50" CornerRadius="25"
                            Background="#E3F2FD" Margin="20,0,15,0">
                        <TextBlock Text="👔" FontSize="26"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUẢN LÝ NHÂN SỰ" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryColor}"/>
                        <TextBlock Text="Thêm, sửa, xóa và quản lý thông tin nhân viên"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryColor}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Form Panel -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Border Background="{StaticResource SecondaryColor}" CornerRadius="8,8,0,0" Padding="15" Margin="-20,-20,-20,0">
                        <TextBlock Text="THÔNG TIN NHÂN VIÊN" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" FontSize="15"/>
                    </Border>

                    <StackPanel Margin="0,20,0,0">
                        <TextBlock x:Name="lblFormTitle" Text="THÊM MỚI" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource SecondaryColor}" HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Họ Tên" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtName" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Số Điện Thoại" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,15,0,8"/>
                        <TextBox x:Name="txtPhone" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Giới Tính" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,15,0,8"/>
                        <ComboBox x:Name="cbGender" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Nam"/>
                            <ComboBoxItem Content="Nữ"/>
                        </ComboBox>

                        <TextBlock Text="Tuổi" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,15,0,8"/>
                        <TextBox x:Name="txtAge" Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Chức Vụ" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,15,0,8"/>
                        <ComboBox x:Name="cbPosition" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Lễ Tân"/>
                            <ComboBoxItem Content="Huấn Luyện Viên"/>
                            <ComboBoxItem Content="Quản Lý"/>
                            <ComboBoxItem Content="Nhân Viên Vệ Sinh"/>
                            <ComboBoxItem Content="Bảo Vệ"/>
                        </ComboBox>

                        <TextBlock Text="Ca Làm Việc" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,15,0,8"/>
                        <ComboBox x:Name="cbShift" Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="Ca 1: 6h - 14h"/>
                            <ComboBoxItem Content="Ca 2: 14h - 22h"/>
                            <ComboBoxItem Content="Ca 3: 10h - 18h"/>
                        </ComboBox>

                        <Button x:Name="btnSave" Content="THÊM MỚI" Style="{StaticResource SecondaryButton}"
                                Height="45" Margin="0,25,0,0" Click="BtnSave_Click"/>

                        <Button x:Name="btnClear" Content="Nhập Lại" Style="{StaticResource OutlineButton}"
                                Height="40" Margin="0,12,0,0" Click="BtnClear_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data Panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Danh Sách Nhân Viên" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSearch" Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                     ToolTip="Nhập tên để tìm kiếm..."/>
                            <Button Content="TÌM KIẾM" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Width="130" Margin="10,0,0,0" Click="BtnSearch_Click"/>
                            <Button Content="LÀM MỚI" Grid.Column="2" Style="{StaticResource AccentButton}"
                                    Width="130" Margin="10,0,0,0" Click="BtnRefresh_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- Data Grid -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            CornerRadius="8" Background="{StaticResource SurfaceColor}">
                        <DataGrid x:Name="gridStaff" Style="{StaticResource ModernDataGrid}"
                                  SelectionChanged="GridStaff_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                <DataGridTextColumn Header="Họ Tên" Binding="{Binding Name}" Width="*" MinWidth="140"/>
                                <DataGridTextColumn Header="SĐT" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="Giới Tính" Binding="{Binding Gender}" Width="90"/>
                                <DataGridTextColumn Header="Tuổi" Binding="{Binding Age}" Width="60"/>
                                <DataGridTextColumn Header="Chức Vụ" Binding="{Binding Position}" Width="140"/>
                                <DataGridTextColumn Header="Ca Làm Việc" Binding="{Binding Shift}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Action Bar -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">

                        <Button Content="XÓA" HorizontalAlignment="Right"
                                Style="{StaticResource DangerButton}"
                                Width="100" Height="45" Click="BtnDelete_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
